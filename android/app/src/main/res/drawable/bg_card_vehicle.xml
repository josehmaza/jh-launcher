<?xml version="1.0" encoding="utf-8"?>
<!-- radial-gradient(ellipse at 50% 65%, cian 6% -> tarjeta) de la maqueta -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient android:type="radial" android:centerX="0.5" android:centerY="0.65" android:gradientRadius="300dp"
        android:startColor="#0f212f" android:endColor="#0c1017" />
    <stroke android:width="1dp" android:color="@color/cyan_15" />
    <corners android:radius="14dp" />
</shape>
