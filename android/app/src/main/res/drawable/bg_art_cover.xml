<?xml version="1.0" encoding="utf-8"?>
<!-- Carátula: borde cian de 2dp mientras suena la música (opción B "latido con el segundero") -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true"><shape android:shape="rectangle"><solid android:color="#1b2333" /><stroke android:width="2dp" android:color="@color/accent_cyan" /><corners android:radius="10dp" /></shape></item>
    <item><shape android:shape="rectangle"><solid android:color="#1b2333" /><stroke android:width="1dp" android:color="@color/white_15" /><corners android:radius="10dp" /></shape></item>
</selector>
