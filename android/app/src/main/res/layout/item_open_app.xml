<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="80dp"
    android:background="@drawable/bg_app_item"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingLeft="16dp"
    android:paddingRight="12dp">

    <ImageView
        android:id="@+id/openAppIcon"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:scaleType="fitCenter" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <com.jh.launcher.JhTextView
            android:id="@+id/openAppLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="18dp"
            app:jhFont="extrabold" />

        <com.jh.launcher.JhTextView
            android:id="@+id/openAppPkg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_secondary"
            android:textSize="11dp"
            app:jhFont="mono" />
    </LinearLayout>

    <com.jh.launcher.JhTextView
        android:id="@+id/openAppClose"
        android:layout_width="132dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_btn_haptic"
        android:clickable="true"
        android:gravity="center"
        android:letterSpacing="0.06"
        android:text="CERRAR"
        android:textColor="@color/accent_crimson"
        android:textSize="15dp"
        app:jhFont="extrabold" />
</LinearLayout>
